{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grib-kontrol.invalid/schema/reference-pack/search-index-descriptor.schema.json",
  "title": "Search index descriptor v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["region_id", "view_type", "embedding_model_id", "embedding_dimension", "index_format_version", "engine", "engine_version", "metric", "vector_count", "shard_count", "loading_mode"],
  "properties": {
    "region_id": {"type": "string", "minLength": 1},
    "view_type": {"type": "string", "enum": ["CAP_TOP", "UNDERSIDE", "STEM", "STEM_BASE", "SIDE"]},
    "embedding_model_id": {"type": "string", "minLength": 1},
    "embedding_dimension": {"type": "integer", "minimum": 1, "maximum": 2147483647},
    "index_format_version": {"type": "string", "minLength": 1},
    "engine": {"type": "string", "enum": ["USEARCH_HNSW", "HNSWLIB", "SQLITE_VEC1", "EXACT_BASELINE"]},
    "engine_version": {"type": "string", "minLength": 1},
    "metric": {"type": "string", "minLength": 1},
    "vector_count": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
    "shard_count": {"type": "integer", "minimum": 1, "maximum": 2147483647},
    "loading_mode": {"type": "string", "enum": ["MEMORY_MAPPED", "PAGE_BASED", "SYNTHETIC_IN_MEMORY_ONLY"]}
  }
}
