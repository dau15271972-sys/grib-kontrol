{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grib-kontrol.invalid/schema/reference-pack/manifest.schema.json",
  "title": "Mandatory offline knowledge pack manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "pack_format_version", "pack_id", "pack_version", "created_at", "region_ids",
    "minimum_app_version", "maximum_app_version",
    "model_contract_version", "model_id", "model_path", "model_sha256",
    "embedding_model_id", "embedding_model_path", "embedding_model_sha256", "embedding_dimension", "embedding_dtype",
    "taxonomy_version", "taxonomy_path", "taxonomy_sha256",
    "confusion_groups_version", "confusion_groups_path", "confusion_groups_sha256",
    "open_set_version", "open_set_path", "open_set_sha256",
    "calibration_version", "calibration_path", "calibration_sha256",
    "risk_rules_version", "risk_rules_path", "risk_rules_sha256",
    "reference_observation_count", "reference_image_count",
    "declared_archive_size_bytes", "declared_unpacked_size_bytes", "file_count",
    "vector_search_engine", "vector_search_engine_version", "search_index_format_version",
    "index_algorithm", "index_metric", "index_quantization", "index_shard_count", "index_vector_count", "index_path",
    "index_build_config_path", "index_build_config_sha256",
    "index_benchmark_report_path", "index_benchmark_report_sha256",
    "exact_rerank_enabled", "exact_rerank_embedding_dtype",
    "license_manifest_path", "license_manifest_sha256",
    "file_manifest_path", "file_manifest_sha256", "checksums_path", "checksums_sha256",
    "signature_algorithm", "signing_key_id", "signature_required", "production_approved"
  ],
  "properties": {
    "pack_format_version": {"type": "string", "const": "1.0.0"},
    "pack_id": {"type": "string", "pattern": "^pack_[a-z0-9]+(?:_[a-z0-9]+)*$"},
    "pack_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[a-z0-9.-]+)?$"},
    "created_at": {"type": "string", "format": "date-time"},
    "region_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "minimum_app_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "maximum_app_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "model_contract_version": {"type": "string", "minLength": 1},
    "model_id": {"type": "string", "minLength": 1},
    "model_path": {"type": "string", "minLength": 1},
    "model_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "embedding_model_id": {"type": "string", "minLength": 1},
    "embedding_model_path": {"type": "string", "minLength": 1},
    "embedding_model_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "embedding_dimension": {"type": "integer", "minimum": 1},
    "embedding_dtype": {"type": "string", "enum": ["float32", "float16", "int8"]},
    "taxonomy_version": {"type": "string", "minLength": 1},
    "taxonomy_path": {"type": "string", "minLength": 1},
    "taxonomy_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "confusion_groups_version": {"type": "string", "minLength": 1},
    "confusion_groups_path": {"type": "string", "minLength": 1},
    "confusion_groups_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "open_set_version": {"type": "string", "minLength": 1},
    "open_set_path": {"type": "string", "minLength": 1},
    "open_set_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "calibration_version": {"type": "string", "minLength": 1},
    "calibration_path": {"type": "string", "minLength": 1},
    "calibration_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "risk_rules_version": {"type": "string", "minLength": 1},
    "risk_rules_path": {"type": "string", "minLength": 1},
    "risk_rules_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "reference_observation_count": {"type": "integer", "minimum": 0},
    "reference_image_count": {"type": "integer", "minimum": 0},
    "declared_archive_size_bytes": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
    "declared_unpacked_size_bytes": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
    "file_count": {"type": "integer", "minimum": 1, "maximum": 2147483647},
    "vector_search_engine": {"type": "string", "enum": ["USEARCH_HNSW", "HNSWLIB", "SQLITE_VEC1", "EXACT_BASELINE"]},
    "vector_search_engine_version": {"type": "string", "minLength": 1},
    "search_index_format_version": {"type": "string", "minLength": 1},
    "index_algorithm": {"type": "string", "minLength": 1},
    "index_metric": {"type": "string", "minLength": 1},
    "index_quantization": {"type": "string", "minLength": 1},
    "index_shard_count": {"type": "integer", "minimum": 1, "maximum": 2147483647},
    "index_vector_count": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
    "index_path": {"type": "string", "minLength": 1},
    "index_build_config_path": {"type": "string", "minLength": 1},
    "index_build_config_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "index_benchmark_report_path": {"type": "string", "minLength": 1},
    "index_benchmark_report_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "exact_rerank_enabled": {"type": "boolean"},
    "exact_rerank_embedding_dtype": {"type": "string", "enum": ["float32", "float16"]},
    "license_manifest_path": {"type": "string", "minLength": 1},
    "license_manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "file_manifest_path": {"type": "string", "const": "file-manifest.json"},
    "file_manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "checksums_path": {"type": "string", "const": "checksums.sha256"},
    "checksums_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "signature_algorithm": {"type": "string", "minLength": 1},
    "signing_key_id": {"type": ["string", "null"]},
    "signature_required": {"type": "boolean"},
    "production_approved": {"type": "boolean"}
  }
}
